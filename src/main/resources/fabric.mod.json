{
  "schemaVersion": 1,
  "id": "bmd",
  "version": "${version}",
  "name": "Blind Mute Deaf",
  "description": "Tryb zabawy: kazdy gracz traci jeden zmysl - wzrok, glos albo sluch. Komunikacja przez kolo gestow.",
  "authors": [
    "Piotr Kajor"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.kajor.bmd.BmdMod"
    ],
    "client": [
      "dev.kajor.bmd.client.BmdClient"
    ],
    "voicechat": [
      "dev.kajor.bmd.voice.BmdVoicechatPlugin"
    ]
  },
  "mixins": [
    "bmd.mixins.json",
    {
      "config": "bmd.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "voicechat": "*"
  }
}
