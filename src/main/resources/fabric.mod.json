{
  "schemaVersion": 1,
  "id": "bmd",
  "version": "${version}",
  "name": "Blind Mute Deaf",
  "description": "A party game mode where every player loses one sense - sight, voice or hearing. They communicate through a gesture wheel and item signs.",
  "authors": [
    "Piotr Kajor"
  ],
  "contact": {
    "homepage": "https://github.com/PiotrKajor/bmd",
    "sources": "https://github.com/PiotrKajor/bmd",
    "issues": "https://github.com/PiotrKajor/bmd/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "pl.skynetgames.bmd.BmdMod"
    ],
    "client": [
      "pl.skynetgames.bmd.client.BmdClient"
    ],
    "voicechat": [
      "pl.skynetgames.bmd.voice.BmdVoicechatPlugin"
    ]
  },
  "mixins": [
    "bmd.mixins.json",
    {
      "config": "bmd.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "voicechat": "*"
  }
}
